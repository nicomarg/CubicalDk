(; ------ ------ ------ < Cubical Type Theory >

        Based on the CCHM.
;)

def cT := xT.
def ceps := xeps.

I : cT.
0 : ceps I.
1 : ceps I.

(; These two operators are commutative and associative. ;)
(;TODO: Add commu externe & assoc par reecriture ;)

def Imin : ceps I -> ceps I -> ceps I.

[] Imin _ 0 --> 0.
[] Imin 0 _ --> 0.
[a] Imin a 1 --> a.
[a] Imin 1 a --> a.


def Imax : ceps I -> ceps I -> ceps I.

[a] Imax a 0 --> a.
[a] Imax 0 a --> a.
[] Imax _ 1 --> 1.
[] Imax 1 _ --> 1.

def sym : ceps I -> ceps I.

[]     sym 0 --> 1.
[]     sym 1 --> 0.
[a, b] sym (Imax a b) --> Imin (sym a) (sym b).
[a, b] sym (Imin a b) --> Imax (sym a) (sym b).


def Path : i : Lev ->  A : T i -> u : eps i A -> v : eps i A -> T i.


def lam : i : Lev -> A : T i -> p : (ceps I -> eps i A) -> eps i (Path i A (p 0) (p 1)).
def app : i : Lev -> A : T i -> u : eps i A -> v : eps i A -> eps i (Path i A u v) -> ceps I -> eps i A.


[A, p, i]      app _ A _ _ (lam _ A p) i --> (p i).
[u]         app _ _ u _ _ 0 --> u.
[v]         app _ _ _ v _ 1 --> v.


(; Is this equivalent to what's above ? Probably not, aEg is new, but the others are less powerful version of the above ;)
def a0 : i : Lev -> A : T i -> u : eps i A -> v : eps i A -> p : eps i (Path i A u v) -> tEq i A (app i A u v p 0) u.
def a1 : i : Lev -> A : T i -> u : eps i A -> v : eps i A -> p : eps i (Path i A u v) -> tEq i A (app i A u v p 1) v.
def aEg : l : Lev -> A : T l -> e1 : eps l A -> e2 : eps l A -> u : eps l (Path l A e1 e2) -> v : eps l (Path l A e1 e2)
-> p : (i : ceps I -> tEq l A (app l A e1 e2 u i) (app l A e1 e2 v i))
-> tEq l (Path l A e1 e2) u v.


(; --- FunExt of path types --- ;)


(; This has the expected type but only up to to eta-reduction ;)
def pathfunext : l : Lev -> A : T l -> B : (eps l A -> T l) -> f : tPi l A B -> g : tPi l A B -> 
  p : (x : eps l A -> eps l (Path l (B x) (f x) (g x))) ->
  eps l (Path l (Pi l A B) (x => f x) (x => g x))

        := l : Lev => A : T l => B : (eps l A -> T l) => f : tPi l A B => g : tPi l A B 
                => p : (x : eps l A -> eps l (Path l (B x) (f x) (g x))) =>
                lam l (Pi l A B) (i : ceps I => x : eps l A => app l (B x) (f x) (g x) (p x) i).


