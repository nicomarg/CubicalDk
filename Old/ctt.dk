(;    ---- My 2LTT ---- ;)




Lev : Type.
lsuc : Lev -> Lev.




(; ------ ------ ------ Internal Theory -- ;)



T : Lev -> Type.
def eps : i : Lev -> T i -> Type. 

t : i : Lev -> (T (lsuc i)).
[i] eps (lsuc i) (t i) --> T i.

lUp :  i : Lev -> a : T i -> T (lsuc i).
[i, a] eps (lsuc i) (lUp i a) --> eps i a.

(; Type equalities works like that: A : T i. B : T i. Eq (t i) A B ;)

False : i : Lev -> T i.
def tFalse := (i : Lev => eps i (False i)). 
elimFalse : i : Lev -> j : Lev -> A : T j -> tFalse i -> eps j A.

True : i : Lev -> T i.
def tTrue := (i : Lev => eps i (True i)).
tt : i : Lev -> (tTrue i).
def elimTrue : i : Lev -> j : Lev -> tau : (tTrue i -> T j) -> eps j (tau (tt i)) -> p  : tTrue i -> eps j (tau p).
[i, e] elimTrue i _ _ e (tt i) --> e.


Nat : i : Lev -> T i.
def tNat := (i : Lev => eps i (Nat i)).
zero : i : Lev -> tNat i.
S :    i : Lev -> tNat i -> tNat i.
def recursor : i : Lev -> j : Lev -> tau : (tNat i -> T j)
        -> eps j (tau (zero i))
        -> (n : (tNat i) -> eps j (tau n) -> eps j (tau (S i n)))
        -> (M : tNat i) -> eps j (tau M).

[i, Hz] recursor i _ _ Hz _ (zero i) --> Hz.
[i, j, tau, Hz, Hs, n] recursor i j tau Hz Hs (S i n) --> Hs n (recursor i j tau Hz Hs n).


Pi : i : Lev -> A : T i -> (eps i A -> T i) -> T i.
def tPi := (i : Lev => A : T i => B : (eps i A -> T i) => eps i (Pi i A B)).

[i, A, B] eps i (Pi i A B) --> x : eps i A -> eps i (B x).
def ndPi  := i : Lev => A : T i => B : T i => Pi i A (_ => B).
def tndPi := l : Lev => A : T l => B : T l => (eps l (ndPi l A B)).


Sig : i : Lev -> A : T i -> (eps i A -> T i) -> T i.
def tSig := i : Lev => A : T i => B : (eps i A -> T i) => eps i (Sig i A B).

def pair : i : Lev -> A : T i -> B : (eps i A -> T i) -> a : eps i A -> b : eps i (B a) -> tSig i A B.
def p1 : i : Lev -> A : T i -> B : (eps i A -> T i) ->            tSig i A B -> eps i A.
def p2 : i : Lev -> A : T i -> B : (eps i A -> T i) -> p : tSig i A B -> eps i (B (p1 i A B p)).

[i, A, B, a] p1 i A B (pair i A B a _) --> a.
[i, A, B, b] p2 i A B (pair i A B _ b) --> b.
[i, A, B, e] pair i A B (p1 i A B e) (p2 i A B e) --> e.

def ndSig := (i : Lev => A : T i => B : T i => Sig i A (_ => B)).
def tndSig := (i : Lev => A : T i => B : T i => tSig i A (_ => B)).
def ndpair := (i : Lev => A : T i => B : T i => a : eps i A => b : eps i B => pair i A (_ => B) a b).

Sum: i : Lev -> T i -> T i -> T i.
def tSum := (i : Lev => A : T i => B : T i => eps i (Sum i A B)).
injl : i : Lev -> A : T i -> B : T i -> (eps i A) -> tSum i A B.
injr : i : Lev -> A : T i -> B : T i -> (eps i B) -> tSum i A B.
def case : i : Lev -> j : Lev -> A : T i -> B : T i -> tau : (tSum i A B -> T j)
        -> (a : eps i A -> eps j (tau (injl i A B a)))
        -> (b : eps i B -> eps j (tau (injr i A B b)))
        -> e : tSum i A B -> eps j (tau e).

[i, A, B, caseA, e] case i _ A B _ caseA _ (injl i A B e) --> (caseA e).
[i, A, B, caseB, e] case i _ A B _ _ caseB (injr i A B e) --> (caseB e).

Eq : i : Lev -> A : T i -> eps i A -> eps i A -> T i.
def tEq := (i : Lev => A : T i => x : eps i A => y : eps i A => eps i (Eq i A x y)).
refl : i : Lev -> A : T i -> m : eps i A -> tEq i A m m.
def J : i : Lev -> j : Lev -> A : T i -> x : eps i A -> tau : (y : eps i A -> p : tEq i A x y -> T j)
        -> H : eps j (tau x (refl i A x))
        -> y : eps i A -> p : tEq i A x y -> eps j (tau y p).
[i, A, H, M] J i _ A M _ H M (refl i A M) --> H.

def TEq  := l : Lev => A : T l => B : T l => Eq (lsuc l) (t l) A B.
def tTEq := l : Lev => A : T l => B : T l => eps (lsuc l) (TEq l A B).



(; ------ ------ ------ External Theory -- ;)


xT : Type.
def xeps : xT -> Type. 

xFalse : xT.
def xtFalse := xeps xFalse. 
xelimFalse : A : xT -> xtFalse -> xeps A.

xTrue : xT.
def xtTrue := xeps xTrue.
xtt : xtTrue.
def xelimTrue : tau : (xtTrue -> xT) -> xeps (tau xtt) -> p  : xtTrue -> xeps (tau p).
[e] xelimTrue _ e xtt --> e.


xNat : xT.
def xtNat := xeps xNat.
xzero : xtNat.
xS : xtNat -> xtNat.
def xrecursor : tau : (xtNat -> xT)
        -> xeps (tau xzero)
        -> (n : xtNat -> xeps (tau n) -> xeps (tau (xS n)))
        -> (M : xtNat) -> xeps (tau M).

[Hz] xrecursor _ Hz _ xzero --> Hz.
[tau, Hz, Hs, n] xrecursor tau Hz Hs (xS n) --> Hs n (xrecursor tau Hz Hs n).


xPi : A : xT -> (xeps A -> xT) -> xT.
def xtPi := (A : xT => B : (xeps A -> xT) => xeps (xPi A B)).

[A, B] xeps (xPi A B) --> x : xeps A -> xeps (B x).
def xndPi := (A : xT  => B : xT => xPi A (_ => B)).
def xtndPi := A : xT => B : xT => (xeps (xndPi A B)).

xSig : A : xT -> (xeps A -> xT) -> xT.
def xtSig := (A : xT => B : (xeps A -> xT) => xeps (xSig A B)).

def xpair : A : xT -> B : (xeps A -> xT) -> a : xeps A -> b : xeps (B a) -> xtSig A B.
def xp1   : A : xT -> B : (xeps A -> xT) -> xtSig A B -> xeps A.
def xp2   : A : xT -> B : (xeps A -> xT) -> p : xtSig A B -> xeps (B (xp1 A B p)).

[A, B, a] xp1 A B (xpair A B a _) --> a.
[A, B, b] xp2 A B (xpair A B _ b) --> b.
[A, B, e] xpair A B (xp1 A B e) (xp2 A B e) --> e.

def xndSig := (A : xT => B : xT => xSig A (_ => B)).
def xtndSig := (A : xT => B : xT => xtSig A (_ => B)).
def xndpair := (A : xT => B : xT => a : xeps A => b : xeps B => xpair A (_ => B) a b).
def xndp1 := A : xT => B : xT => e : xtndSig A B => xp1 A (_ => B) e.
def xndp2 := A : xT => B : xT => e : xtndSig A B => xp2 A (_ => B) e.

xSum: xT -> xT -> xT.
def xtSum := (A : xT => B : xT => xeps (xSum A B)).
xinjl : A : xT -> B : xT -> xeps A -> xtSum A B.
xinjr : A : xT -> B : xT -> xeps B -> xtSum A B.
def xcase : A : xT -> B : xT -> tau : (xtSum A B -> xT)
        -> (a : xeps A -> xeps (tau (xinjl A B a)))
        -> (b : xeps B -> xeps (tau (xinjr A B b)))
        -> e : xtSum A B -> xeps (tau e).

[A, B, caseA, e] xcase A B _ caseA _ (xinjl A B e) --> (caseA e).
[A, B, caseB, e] xcase A B _ _ caseB (xinjr A B e) --> (caseB e).

xEq : A : xT -> xeps A -> xeps A -> xT.
def xtEq := (A : xT => x : xeps A => y : xeps A => xeps (xEq A x y)).
xrefl : A : xT -> m : xeps A -> xtEq A m m.
def xJ : A : xT -> x : xeps A -> tau : (y : xeps A -> p : xtEq A x y -> xT)
        -> H : xeps (tau x (xrefl A x))
        -> y : xeps A -> p : xtEq A x y -> xeps (tau y p).
[A, H, M] xJ A M _ H M (xrefl A M) --> H.

def xK : A : xT -> x : xeps A -> tau : (p : xtEq A x x -> xT)
        -> H : xeps (tau (xrefl A x))
        -> p : xtEq A x x -> xeps (tau p).

[A, H, M] xK A M _ H (xrefl A M) --> H.

(; TODO: prove it ;)
def xUIP : A : xT -> x : xeps A -> y : xeps A -> p : xtEq A x y -> p' : xtEq A x y ->
        xtEq (xEq A x y) p p'.

def xFunext : A : xT -> B : (xeps A -> xT) -> f : xtPi A B -> g : xtPi A B ->
                p : (a : (xeps A) -> xtEq (B a) (f a) (g a))
                -> xtEq (xPi A B) f g.




(; ------ ------- ------- Coercion ;)




def c  :  i : Lev ->     T i -> xT.
def tc := i : Lev => A : T i => xeps (c i A).

def isoUp :   i : Lev -> A : T i -> eps i A -> tc i A. 
def isoDown : i : Lev -> A : T i -> tc i A  -> eps i A.
[i, A, a] isoDown i A (isoUp i A a) --> a.
[i, A, a] isoUp i A (isoDown i A a) --> a.

(; Used in dependent types to change a A -> B to a c A -> "c B", it's the "c B" part;)
def clift := i : Lev => A : T i => B : (eps i A -> T i) => (xa => c i (B (isoDown i A xa))).




(; ------ ------- ------- Lemma 2.TrueTrue ;)





(;2.2 ---  ;)

def isoTrueUp   :=   i : Lev =>  e : tc i (True i) => xtt.
def isoTrueDown :=   i : Lev =>  e : xtTrue        => isoUp i (True i) (tt i).


(;2.3 --- ;)

def downsig    := i : Lev => A : T i => B : (eps i A -> T i) => e : tc i (Sig i A B) => isoDown i (Sig i A B) e.

def isoSigUp   := i : Lev => A : T i => B : (eps i A -> T i) => e : tc i (Sig i A B) =>
        xpair (c i A) (clift i A B)
              (isoUp i A (p1 i A B (downsig i A B e)))
              (isoUp i (B (p1 i A B (downsig i A B e))) (p2 i A B (downsig i A B e))).

def isoSigDown := i : Lev => A : T i => B : (eps i A -> T i) => e : xtSig (c i A) (clift i A B) => isoUp i (Sig i A B)
        (pair i A B
                (isoDown i A (xp1 (c i A) (clift i A B) e))
                (isoDown i (B (isoDown i A (xp1 (c i A) (clift i A B) e))) (xp2 (c i A) (clift i A B) e))).


(;2.4 ---  ;)

def downpi    :=  i : Lev => A : T i => B : (eps i A -> T i) => e : tc i (Pi i A B) => isoDown i (Pi i A B) e.
def isoPiUp   :=  i : Lev => A : T i => B : (eps i A -> T i) => e : tc i (Pi i A B) =>
        (x : tc i A => (isoUp i (B (isoDown i A x)) ((downpi i A B e) (isoDown i A x)))).
def isoPiDown :=  i : Lev => A : T i => B : (eps i A -> T i) => e : xtPi (c i A) (clift i A B) =>
        isoUp i (Pi i A B) (x : eps i A => isoDown i (B x) (e (isoUp i A x))).


(;2.5 ---

      From now one the reciprocal aren't possible.

      For ex, isoSumUp := (A : T => B : T => e : eps (Sum A B) => case A B (_ => xSum (c A) (c B)) (x : eps A => xinjl (c A) (c B) (isoUp A x)) (x : eps B => xinjr (c A) (c B) (isoUp B x)) e).
      Is impossible : tau must go to -> T, it can't go to an external type, while for the reciprocal we can eliIminate to an c (Sum A B)  --- Since T < xT

;)

def isoSumDown : l : Lev -> A : T l -> B : T l ->     xtSum (c l A) (c l B) -> tc l (Sum l A B) :=
                 l : Lev => A : T l => B : T l => e : xtSum (c l A) (c l B) =>
xcase (c l A) (c l B) (_ => c l (Sum l A B))
        (x : tc l A => isoUp l (Sum l A B) (injl l A B (isoDown l A x)))
        (x : tc l B => isoUp l (Sum l A B) (injr l A B (isoDown l B x)))
        e.

(;2.6 --- ;)

def isoFalseDown : l : Lev -> xtFalse -> tc l (False l) := l : Lev => e : xtFalse =>  xelimFalse (c l (False l)) e.


(;2.7 --- ;)

def isoNatDown : l : Lev -> xtNat -> tc l (Nat l) := l : Lev => e : xtNat =>
xrecursor (xm => c l (Nat l))
          (isoUp l (Nat l) (zero l))
          (_ => xm => isoUp l (Nat l) (S l (isoDown l (Nat l) xm)))
          e.


(;2.8 --- ;)

def isoEqDown : l : Lev -> A : T l -> u : eps l A -> v : eps l A ->     xtEq (c l A) (isoUp l A u) (isoUp l A v) -> 
                        tc l (Eq l A u v) :=
                l : Lev => A : T l => u : eps l A => v : eps l A => p : xtEq (c l A) (isoUp l A u) (isoUp l A v) =>
                        xJ (c l A) (isoUp l A u)
                           (y => q => c l (Eq l A u (isoDown l A y)))
                           (isoUp l (Eq l A u u) (refl l A u))
                           (isoUp l A v) p.


